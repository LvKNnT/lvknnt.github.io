---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Work" description="Selected research, security, software, and creative projects by Lâm Vĩnh Khang." active="work">
  <div class="page-heading"><span class="section-index">RESEARCH & ENGINEERING</span><h1>Selected <em>work.</em></h1><p>Projects spanning cryptography, security practice, research software, and systems built with teams.</p></div>
  <div class="project-list">
    {projects.map((project, index) => <article class="project-row">
      <div class="project-ordinal"><span>{String(index + 1).padStart(2, '0')}</span><span>{project.year}</span></div>
      <div class="project-main">
        {project.image && <div class="project-image"><img src={project.image} alt={project.imageAlt || ''} loading="lazy" /></div>}
        <div class="project-meta"><span>{project.type}</span><span>{project.tags.join(' / ')}</span></div>
        <h2>{project.title}</h2><p>{project.description}</p>
      </div>
      {project.href && <a class="project-link" href={project.href} aria-label={`View ${project.title} project`}><span aria-hidden="true">↗</span></a>}
    </article>)}
  </div>
</BaseLayout>
