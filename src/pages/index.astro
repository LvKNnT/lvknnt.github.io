---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { formatPostDate, getPublicPosts } from '../data/posts';

const latestPosts = (await getPublicPosts()).slice(0, 3);
const featured = [
  projects.find((item) => item.title === 'Cryptanalysis & CTF Practice'),
  projects.find((item) => item.title === 'Temporal Path Computation'),
  projects.find((item) => item.title === 'Toward Real-World Discontinuity Supervision for Video Frame Interpolation'),
].filter((item) => item !== undefined);
---
<BaseLayout title="Lâm Vĩnh Khang" description="Cryptography, security research, and careful software engineering by Lâm Vĩnh Khang." active="home">
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> Computer science · Cryptography · Security</p>
      <h1 id="intro-title">Curiosity, <em>made rigorous.</em></h1>
      <p class="hero-lead">I’m Lâm Vĩnh Khang, a computer science student turning mathematical ideas into practical security research and dependable software.</p>
      <div class="hero-actions">
        <a class="button-primary" href="/work/">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/resume.pdf">Download résumé <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-socials" aria-label="Contact and profiles">
        <a href="https://github.com/LvKNnT" rel="me">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/lvknntuwu/" rel="me">LinkedIn ↗</a>
        <a href="mailto:khanglamtat@gmail.com">Email ↗</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="portrait-wrap"><img src="/avatar.png" alt="Portrait of Lâm Vĩnh Khang" width="1600" height="1600" /></div>
      <div class="portrait-caption"><span>01 / PROFILE</span><span>Ho Chi Minh City, Vietnam</span></div>
      <div class="visual-orbit" aria-hidden="true"></div>
    </div>
  </section>

  <section class="intro-grid section-block" aria-labelledby="about-title">
    <div class="section-aside"><span class="section-index">01 / ABOUT</span><h2 id="about-title">A little about me</h2></div>
    <div class="intro-body">
      <p>I study Computer Science in the Advanced Program at VNUHCM – University of Science. My interests sit where mathematics, security, and implementation meet: cryptanalysis, lattice based cryptography, elliptic curves, and post quantum systems.</p>
      <p>In CTFs I build Python and SageMath attacks, then write up the reasoning so others can reproduce the result. I also enjoy implementing research papers, measuring performance, and building backend tools that survive real use.</p>
      <div class="facts-grid">
        <div><strong>4.0 / 4.0</strong><span>University GPA</span></div>
        <div><strong>1st / 200+</strong><span>UIT WannaGame teams</span></div>
        <div><strong>2028</strong><span>Expected graduation</span></div>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="featured-title">
    <div class="section-heading"><div><span class="section-index">02 / SELECTED WORK</span><h2 id="featured-title">Work worth exploring.</h2></div><a class="text-link" href="/work/">All projects <span aria-hidden="true">↗</span></a></div>
    <div class="featured-grid">
      {featured.map((project, index) => <article class="featured-card">
        <span class="card-number">0{index + 1} / {project.year}</span>
        {project.image && <img src={project.image} alt={project.imageAlt || ''} />}
        <div class="featured-content"><p class="card-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="card-bottom"><span>{project.tags.slice(0, 2).join(' · ')}</span>{project.href && <a href={project.href} aria-label={`View ${project.title}`}><span aria-hidden="true">↗</span></a>}</div></div>
      </article>)}
    </div>
  </section>

  <section class="section-block writing-preview" aria-labelledby="writing-title">
    <div class="section-heading"><div><span class="section-index">03 / FIELD NOTES</span><h2 id="writing-title">Thinking out loud.</h2></div><a class="text-link" href="/posts/">All writing <span aria-hidden="true">↗</span></a></div>
    <div class="writing-list">
      {latestPosts.map((post) => <a class="writing-row" href={`/posts/${post.id}/`}><span class="writing-date">{formatPostDate(post.data.date, { day: undefined, month: 'short' })}</span><span class="writing-title">{post.data.title}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>

  <section class="contact-banner" aria-labelledby="contact-title"><div><span class="section-index">04 / GET IN TOUCH</span><h2 id="contact-title">Have a problem worth solving?</h2><p>I’m open to security internships, research collaboration, and conversations about cryptography.</p></div><a class="button-light" href="mailto:khanglamtat@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
